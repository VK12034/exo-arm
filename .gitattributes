# Normalise to LF in the repository; the Teensy toolchain and CI both run on
# Linux, and mixed endings make diffs unreadable.
* text=auto eol=lf

*.step binary
*.stp  binary
*.stl  binary
*.pdf  binary
*.png  binary
*.jpg  binary

# Fusion native files and large exports are binary; never try to diff or
# normalise them.
*.f3d  binary
*.f3z  binary
